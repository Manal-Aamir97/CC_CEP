# Copy this file to .env (never commit .env).

# Your OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# The one model used for the whole study. Do not change it once the pilot has started.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# openrouter = the real assistant; stub = canned test replies; none = assistant unavailable
CEP_LLM_PROVIDER=openrouter
